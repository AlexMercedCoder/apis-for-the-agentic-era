{
  "name": "run_graphql",
  "description": "Run one read-only GraphQL query against Harbor's storefront API. Read the schema first with an introspection query. Mutations are refused. Queries deeper than 6 levels or costlier than 1000 are refused.",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "A GraphQL query document"
      },
      "variables": {
        "type": "object"
      }
    },
    "required": [
      "query"
    ]
  }
}
