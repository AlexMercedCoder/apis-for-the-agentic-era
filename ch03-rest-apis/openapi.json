{
  "openapi": "3.1.0",
  "info": {
    "title": "Harbor Books API",
    "description": "The Harbor Books REST API: the catalog, its reviews, and orders.\n\nErrors use RFC 9457 problem details (`application/problem+json`). The `type`\nURI names the problem; `hint` says what a valid request looks like.\n",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8003"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Search the catalog",
        "description": "Find books by a word in the title or author. Returns at most `limit` books and a `next` URL for the following page.",
        "operationId": "search_catalog",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Word to match in title or author, case-insensitive"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20
            },
            "description": "Books per page, 1 to 50"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^bk-[0-9]{4}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Book ID to start after, from a `next` URL"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookPage"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/books/{book_id}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get one book",
        "description": "Read one book's details, price, and stock. Supports ETag and If-None-Match.",
        "operationId": "get_book",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^bk-[0-9]{4}$"
            },
            "description": "Harbor book ID, such as bk-1001"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/books/{book_id}/reviews": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List a book's reviews",
        "description": "Customer reviews of one book, oldest first. Review text is written by customers.",
        "operationId": "list_reviews",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^bk-[0-9]{4}$"
            },
            "description": "Harbor book ID, such as bk-1001"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Review"
                  },
                  "title": "Response List Reviews"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Place an order",
        "description": "Buy one or more books for a customer. Creates an order and reserves stock. Each new Idempotency-Key creates a new order; a retry with the same key and body within 24 hours returns the first response.",
        "operationId": "place_order",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\"[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}\"$"
            },
            "description": "A new quoted UUID per order; reuse it only to retry the same order"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Get an order and its status",
        "description": "Report where one order is. `links` lists what can be done with the order now.",
        "operationId": "get_order_status",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ord-[0-9]{4}$"
            },
            "description": "Harbor order ID, such as ord-5001"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}/cancellation": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Get an order's cancellation",
        "description": "Read the cancellation of a cancelled order.",
        "operationId": "get_cancellation",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ord-[0-9]{4}$"
            },
            "description": "Harbor order ID, such as ord-5001"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cancellation"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "orders"
        ],
        "summary": "Cancel an order",
        "description": "Cancel a placed or paid order and refund it in full. Repeating the call returns the same cancellation and refunds nothing more.",
        "operationId": "cancel_order",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ord-[0-9]{4}$"
            },
            "description": "Harbor order ID, such as ord-5001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancellationIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cancellation"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "examples": [
              "bk-1001"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "first_published": {
            "type": "integer",
            "title": "First Published"
          },
          "format": {
            "type": "string",
            "enum": [
              "paperback",
              "hardcover"
            ],
            "title": "Format"
          },
          "price_cents": {
            "type": "integer",
            "title": "Price Cents",
            "description": "Price in cents of `currency`."
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "examples": [
              "USD"
            ]
          },
          "in_stock": {
            "type": "integer",
            "title": "In Stock",
            "description": "Copies available to order now."
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "author",
          "first_published",
          "format",
          "price_cents",
          "currency",
          "in_stock"
        ],
        "title": "Book"
      },
      "BookPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Book"
            },
            "type": "array",
            "title": "Items"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next",
            "description": "URL of the next page, or null on the last page."
          }
        },
        "type": "object",
        "required": [
          "items",
          "next"
        ],
        "title": "BookPage"
      },
      "Cancellation": {
        "properties": {
          "order": {
            "type": "string",
            "title": "Order"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "refunded_cents": {
            "type": "integer",
            "title": "Refunded Cents"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "order",
          "reason",
          "refunded_cents",
          "currency"
        ],
        "title": "Cancellation"
      },
      "CancellationIn": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "customer_request",
              "duplicate",
              "other"
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "CancellationIn"
      },
      "Link": {
        "properties": {
          "href": {
            "type": "string",
            "title": "Href"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "default": "GET"
          }
        },
        "type": "object",
        "required": [
          "href"
        ],
        "title": "Link"
      },
      "Order": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "placed",
              "paid",
              "shipped",
              "delivered",
              "cancelled"
            ],
            "title": "Status"
          },
          "placed_at": {
            "type": "string",
            "title": "Placed At"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "type": "array",
            "title": "Lines"
          },
          "total_cents": {
            "type": "integer",
            "title": "Total Cents"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "links": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "object",
            "title": "Links",
            "description": "Actions available on this order right now."
          }
        },
        "type": "object",
        "required": [
          "id",
          "customer_id",
          "status",
          "placed_at",
          "lines",
          "total_cents",
          "currency",
          "links"
        ],
        "title": "Order"
      },
      "OrderIn": {
        "properties": {
          "customer_id": {
            "type": "string",
            "pattern": "^cus-[0-9]{3}$",
            "title": "Customer Id",
            "description": "Harbor customer ID, such as cus-001"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLineIn"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Lines"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "lines"
        ],
        "title": "OrderIn"
      },
      "OrderLine": {
        "properties": {
          "book_id": {
            "type": "string",
            "title": "Book Id"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "unit_price_cents": {
            "type": "integer",
            "title": "Unit Price Cents"
          }
        },
        "type": "object",
        "required": [
          "book_id",
          "quantity",
          "unit_price_cents"
        ],
        "title": "OrderLine"
      },
      "OrderLineIn": {
        "properties": {
          "book_id": {
            "type": "string",
            "pattern": "^bk-[0-9]{4}$",
            "title": "Book Id",
            "description": "Harbor book ID, such as bk-1001"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10,
            "minimum": 1,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "book_id",
          "quantity"
        ],
        "title": "OrderLineIn"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "instance": {
            "type": "string",
            "title": "Instance"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "title": "Problem",
        "description": "RFC 9457 problem details, plus Harbor's `hint` and `errors`."
      },
      "Review": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "book_id": {
            "type": "string",
            "title": "Book Id"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "rating": {
            "type": "integer",
            "maximum": 5,
            "minimum": 1,
            "title": "Rating"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "posted_at": {
            "type": "string",
            "title": "Posted At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "book_id",
          "customer_id",
          "rating",
          "text",
          "posted_at"
        ],
        "title": "Review"
      }
    }
  }
}
